<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LGDH - Dashboard</title>
    <link rel="stylesheet" href="/public/css/styles.css">
    <link rel="icon" type="image/png" href="/public/images/lgdhlogot.png">
</head>

<body>
    <div class="dashboard-container">
        <% 
            let page = typeof currentPage !== 'undefined' ? currentPage : 'homepage';
            switch (page) {
                case 'configuration':
                    %><%- include('configuration.ejs') %><%
                    break;
                case 'portable':
                    %><%- include('portable.ejs') %><%
                    break;
                case 'upgrade':
                    %><%- include('upgrade.ejs') %><%
                    break;
                default:
                    %><%- include('homepage.ejs') %><%
            }
        %>
    </div>
</body>

</html>