<!DOCTYPE html>
<html>

<body>
    <div class="homepage-container">
        <div class="homepage-box">
            <a href="?page=homepage" class="button" style="margin-bottom: 80px;"><svg viewBox="0 0 24 24" fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                        <path
                            d="M16.19 2H7.81C4.17 2 2 4.17 2 7.81V16.18C2 19.83 4.17 22 7.81 22H16.18C19.82 22 21.99 19.83 21.99 16.19V7.81C22 4.17 19.83 2 16.19 2ZM13.92 16.13H9C8.59 16.13 8.25 15.79 8.25 15.38C8.25 14.97 8.59 14.63 9 14.63H13.92C15.2 14.63 16.25 13.59 16.25 12.3C16.25 11.01 15.21 9.97 13.92 9.97H8.85L9.11 10.23C9.4 10.53 9.4 11 9.1 11.3C8.95 11.45 8.76 11.52 8.57 11.52C8.38 11.52 8.19 11.45 8.04 11.3L6.47 9.72C6.18 9.43 6.18 8.95 6.47 8.66L8.04 7.09C8.33 6.8 8.81 6.8 9.1 7.09C9.39 7.38 9.39 7.86 9.1 8.15L8.77 8.48H13.92C16.03 8.48 17.75 10.2 17.75 12.31C17.75 14.42 16.03 16.13 13.92 16.13Z"
                            fill="#ffffff"></path>
                    </g>
                </svg>Retour</a>
            <form id="question-form" class="question-form">
                <div class="question">
                    <label>Quel est votre budget ?</label>
                    <input type="text" name="budget">
                </div>

                <div class="question">
                    <label>Quels composants possédez-vous déjà ?</label>
                    <input type="text" name="equipements"
                        placeholder="ex : AMD Ryzen 5 5600 • AMD RX 6600 • Souris Logitech G502 Hero • etc...">
                </div>

                <div class="question">
                    <label>Quels composants voulez-vous améliorer ?</label>
                    <input type="text" name="equipements"
                        placeholder="ex : Processeur • RAM • Carte Graphique • etc...">
                </div>

                <div class="question">
                    <label>Quels logiciels/jeux allez-vous utiliser ?</label>
                    <textarea name="softwares" rows="3" placeholder="Listez vos principales utilisations..."></textarea>
                </div>

                <div class="question">
                    <label>Quelle est/sera la résolution de votre écran ?</label>
                    <input type="text" name="resolution" placeholder="ex : 1080p • 1440p • 4k • etc...">
                </div>

                <div class="question">
                    <label>Quel est/sera le taux de rafraîchissement de votre écran ?</label>
                    <input type="text" name="refresh" placeholder="ex : 60hz • 120hz • 144hz • 165hz • 240hz • etc...">
                </div>

                <div class="question">
                    <label>Quels effets d'éclairage voulez-vous ?</label>
                    <div class="options" data-question="rgb">
                        <button type="button" class="option-button" data-value="RGB">RGB</button>
                        <button type="button" class="option-button" data-value="Sobre">Sobre</button>
                        <button type="button" class="option-button" data-value="Mixte">Mixte</button>
                        <input type="hidden" name="rgb" id="rgb">
                    </div>
                </div>

                <div class="question">
                    <label>Quelle couleur majoritaire des composants voulez-vous ?<div class="info-icon">?<span
                                class="info-text">Noir : Standard •
                                Blanc : Légèrement plus cher €</span></div></label>
                    <div class="options" data-question="color">
                        <button type="button" class="option-button" data-value="Noir">Noir</button>
                        <button type="button" class="option-button" data-value="Blanc">Blanc</button>
                        <button type="button" class="option-button" data-value="Autre">Autre</button>
                        <input type="hidden" name="color" id="color">
                    </div>
                    <input type="text" id="other-color" style="display: none; margin-top: 10px;"
                        placeholder="Précisez la couleur souhaitée..." disabled>
                </div>

                <div class="question">
                    <label>Avez-vous des exigences particulières ?</label>
                    <textarea name="requirements" rows="2"
                        placeholder="Silencieux • Transportabilité • Évolutivité dans le temps • Marques • etc..."></textarea>
                </div>

                <div class="question">
                    <label>Quand pouvez-vous commander les composants de l'ordinateur ?<div class="info-icon">?<span
                                class="info-text">Demandez-nous de l'aide uniquement dans un délai
                                compris entre 1 et 2 semaines avant achat.</span>
                        </div></label>
                    <textarea name="delay" rows="2"
                        placeholder="Aujourd'hui • dans 3 jours • dans 1 semaine • etc..."></textarea>
                </div>

                <div class="question">
                    <label>Dans quel pays résidez vous ?</label>
                    <input type="text" name="country">
                </div>

                <div class="question">
                    <label>Êtes-vous d'accord pour acheter internationalement ?<div class="info-icon">?<span
                                class="info-text">Sur des sites
                                étrangers fiables comme Amazon DE, Reichelt, Aliexpress, etc...</span></div></label>
                    <div class="options" data-question="international">
                        <button type="button" class="option-button" data-value="Oui">Oui</button>
                        <button type="button" class="option-button" data-value="Non">Non</button>
                        <input type="hidden" name="international" id="international">
                    </div>
                </div>

                <div style="text-align: center !important;">
                    <div style="margin-bottom: 20px; margin-top: 40px; display: none;" id="copy-confirm-message">
                        <p>Copie effectuée !</p>
                        <p>Merci de coller votre réponse dans le post de demande d'amélioration ⏫.</p>
                    </div>
                    <button type="button" class="button" id="copy-button">📋 Copiez le questionnaire
                        complété...</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const optionGroups = document.querySelectorAll('.options');

        optionGroups.forEach(group => {
            const buttons = group.querySelectorAll('.option-button');
            const questionId = group.dataset.question;
            const hiddenInput = document.getElementById(questionId);

            buttons.forEach(button => {
                button.addEventListener('click', function () {
                    buttons.forEach(btn => {
                        btn.classList.remove('selected');
                        btn.style.background = '#e8f3f7';
                        btn.style.borderColor = '#dbedf3';
                    });

                    this.classList.add('selected');
                    this.style.background = '#f5d6e9';
                    this.style.borderColor = '#f5d6e9';

                    if (hiddenInput) {
                        hiddenInput.value = this.dataset.value;
                    }
                    if (questionId === 'color') {
                        toggleOtherColor();
                    }
                });
            });

            if (buttons.length > 0 && hiddenInput && !hiddenInput.value) {
                buttons[0].click();
            }
        });

        function toggleOtherColor() {
            const colorGroup = document.querySelector('.options[data-question="color"]');
            const otherButton = colorGroup.querySelector('.option-button[data-value="Autre"]');
            const colorInput = document.getElementById('other-color');

            if (otherButton.classList.contains('selected')) {
                colorInput.style.display = 'block';
                colorInput.disabled = false;
            } else {
                colorInput.style.display = 'none';
                colorInput.disabled = true;
                colorInput.value = '';
            }
        }

        // Gestion de la copie des réponses
        document.getElementById('copy-button').addEventListener('click', () => {
            const responses = [];
            const questions = document.querySelectorAll('.question');

            questions.forEach(question => {
                const labelElement = question.querySelector('label');
                if (!labelElement) return;
                const labelText = labelElement.cloneNode(true);
                labelText.querySelectorAll('.info-icon').forEach(icon => icon.remove());
                const label = labelText.textContent.trim();

                let answer = 'Non spécifié';
                const hiddenInput = question.querySelector('input[type="hidden"]');
                const textInput = question.querySelector('input[type="text"]:not(#other-color), textarea');
                const otherColorInput = question.querySelector('#other-color');

                if (hiddenInput && hiddenInput.value) {
                    answer = hiddenInput.value;
                    if (hiddenInput.id === 'color' && hiddenInput.value === 'Autre' && otherColorInput && otherColorInput.value.trim()) {
                        answer = otherColorInput.value.trim();
                    }
                } else if (textInput && textInput.value.trim() && !textInput.disabled) {
                    answer = textInput.value.trim();
                }

                responses.push(`- ${label}\n> ${answer}`);
            });

            const finalText = `### **__Voici mes réponses au questionnaire <@&1008706488145035406> :__**\n\n${responses.join('\n')}`;

            navigator.clipboard.writeText(finalText).then(() => {
                const message = document.getElementById('copy-confirm-message');
                message.style.display = 'block';
                setTimeout(() => message.style.display = 'none', 20000);
            });
        });
    </script>

</body>

</html>